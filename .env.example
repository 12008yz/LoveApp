# --- Local (SQLite, без Docker) ---
DATABASE_URL="file:./dev.db"

# --- Production / Docker Postgres (и в prisma/schema.prisma: provider = "postgresql") ---
# DATABASE_URL="postgresql://love:love@localhost:5432/loveapp?schema=public"

AUTH_SECRET="generate-a-long-random-string"
AUTH_URL="http://localhost:3000"
CRON_SECRET="generate-cron-secret"

# Web Push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Optional S3 / MinIO — if unset, photos go to public/uploads
# S3_ENDPOINT="http://127.0.0.1:9000"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY="minioadmin"
# S3_SECRET_KEY="minioadmin"
# S3_BUCKET="loveapp"
# S3_PUBLIC_URL="http://127.0.0.1:9000/loveapp"
# S3_FORCE_PATH_STYLE="true"
