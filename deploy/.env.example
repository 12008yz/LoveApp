# Copy to .env and replace placeholders before docker compose up.
# Do not commit .env.
#
# MinIO: password must be at least 8 characters.
# Prefer letters/digits only (avoid $ ` " \ in passwords — they break shell init).

POSTGRES_USER=love
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PG_PASSWORD
POSTGRES_DB=loveapp

MINIO_ROOT_USER=loveapp
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD
S3_BUCKET=loveapp

# --- Later (LoveApp app .env), map like this:
# DATABASE_URL=postgresql://love:PASSWORD@127.0.0.1:5432/loveapp?schema=public
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY=<same as MINIO_ROOT_USER>
# S3_SECRET_KEY=<same as MINIO_ROOT_PASSWORD>
# S3_BUCKET=loveapp
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=https://novayaglava.space/media   # after nginx proxy (not in step 1)
