# App env at /opt/loveApp/.env (not deploy/.env — that one is for Docker Postgres/MinIO)

# Fill POSTGRES_PASSWORD / MinIO keys from /opt/loveApp/deploy/.env
DATABASE_URL="postgresql://love:POSTGRES_PASSWORD@127.0.0.1:5432/loveapp?schema=public"

AUTH_SECRET="GENERATE_WITH_openssl_rand_hex_32"
AUTH_URL="https://novayaglava.space"
CRON_SECRET="GENERATE_WITH_openssl_rand_hex_16"

# npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:agriratov@mail.ru"

S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="loveapp"
S3_SECRET_KEY="MINIO_ROOT_PASSWORD_FROM_deploy_env"
S3_BUCKET="loveapp"
# Until nginx /media is ready, local-only URL (browsers off-server won't load photos):
S3_PUBLIC_URL="http://127.0.0.1:9000/loveapp"
S3_FORCE_PATH_STYLE="true"
